#!/usr/bin/env bash
set -euo pipefail

# Anchor paths to this script so it works from any current directory.
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
config_file="${CASE2AUDIO_CONFIG:-$repo_dir/.case2audio.env}"
case2audio_bin="$repo_dir/.venv/bin/case2audio"

usage() {
  cat <<'EOF'
Usage: ./make-audio [--ocr] [--dry-run] PDF [PDF ...] [case2audio make options]

Turn one or more PDFs into separate narration text and Matthew Generative audio.
List all PDFs before shared case2audio options. Up to two PDFs run through Polly at once.
Use --jobs 1 after the PDFs for sequential processing.
Bare filenames are read from ~/Downloads. Use ./file.pdf for the current directory.

  --ocr       Enable OCR for a scanned/image-only PDF.
  --dry-run   Print the command without extracting or calling AWS.
  -h, --help  Show this help.

Examples:
  ./make-audio case.pdf
  ./make-audio bb.pdf sfn.pdf
  ./make-audio --ocr scanned-case.pdf
  ./make-audio ./case.pdf --drop-regex '^confidential$'
EOF
}

use_ocr=false
dry_run=false

# Wrapper-only flags go before the PDFs; shared CLI options go after the file list.
while [[ $# -gt 0 ]]; do
  case "$1" in
    --ocr)
      use_ocr=true
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 2
fi

pdfs=()
# Validate every input before starting work, so a typo in the second path costs nothing.
while [[ $# -gt 0 && "$1" != -* ]]; do
  pdf="$1"
  shift
  # A slash makes the path explicit; bare names always use Downloads to avoid ambiguity.
  if [[ "$pdf" != */* ]]; then
    pdf="$HOME/Downloads/$pdf"
  fi
  if [[ ! -f "$pdf" ]]; then
    echo "PDF not found: $pdf" >&2
    exit 2
  fi
  # Resolve paths before changing directories and keep spaces intact in the array.
  pdf_dir="$(cd -- "$(dirname -- "$pdf")" && pwd -P)"
  pdfs+=("$pdf_dir/$(basename -- "$pdf")")
done

if [[ ${#pdfs[@]} -eq 0 ]]; then
  usage >&2
  exit 2
fi

if [[ ! -f "$config_file" ]]; then
  echo "Missing local config: $config_file" >&2
  echo "Run: cp .case2audio.env.example .case2audio.env" >&2
  exit 2
fi

# This ignored file holds local AWS values without baking them into Git history.
set -a
# shellcheck disable=SC1090
source "$config_file"
set +a

bucket="${CASE2AUDIO_BUCKET:-}"
region="${CASE2AUDIO_REGION:-us-east-1}"
profile="${CASE2AUDIO_PROFILE:-case2audio}"

if [[ -z "$bucket" || "$bucket" == "YOUR-UNIQUE-CASE2AUDIO-BUCKET" ]]; then
  echo "Set CASE2AUDIO_BUCKET in $config_file" >&2
  exit 2
fi

if [[ ! -x "$case2audio_bin" ]]; then
  echo "case2audio is not installed in .venv." >&2
  echo "Run: ./scripts/bootstrap.sh" >&2
  exit 2
fi

command=(
  "$case2audio_bin" make "${pdfs[@]}"
  --bucket "$bucket"
  --region "$region"
  --profile "$profile"
)

# Born-digital PDFs are the common case and do not need slow OCR.
if [[ "$use_ocr" == false ]]; then
  command+=(--no-ocr)
fi

# Advanced CLI flags remain available without making the wrapper complicated.
command+=("$@")

if [[ "$dry_run" == true ]]; then
  printf 'Would run:'
  printf ' %q' "${command[@]}"
  printf '\n'
  exit 0
fi

# Keep every generated job under this repository's ignored generated/ folder.
cd "$repo_dir"
exec "${command[@]}"
