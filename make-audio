#!/usr/bin/env bash
set -euo pipefail

# Anchor paths to this script so it works from any current directory.
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
config_file="${CASE2AUDIO_CONFIG:-$repo_dir/.case2audio.env}"
python_bin="$repo_dir/.venv/bin/python"
# shellcheck source=scripts/runtime.sh
source "$repo_dir/scripts/runtime.sh"

usage() {
  cat <<'EOF'
Usage: ./make-audio [--ocr] [--dry-run] INPUT [INPUT ...] [case2audio make options]

Turn PDFs or UTF-8 .txt scripts into separate Matthew Generative audio.
List all inputs before shared case2audio options. Up to 20 inputs run through Polly at once.
Use --jobs 1 after the inputs for sequential processing.
Bare filenames use this project's input/ folder first, then ~/Downloads.
Use ./file.txt or ./file.pdf for the current directory.

  --ocr       Enable OCR for a scanned/image-only PDF.
  --dry-run   Print the command without extracting or calling AWS.
  -h, --help  Show this help.

Examples:
  ./make-audio case.pdf
  ./make-audio bb.pdf sfn.pdf
  ./make-audio ManEcon_Audio_Review_Script.txt
  ./make-audio input/review.txt case.pdf
  ./make-audio --ocr scanned-case.pdf
  ./make-audio ./case.pdf --drop-regex '^confidential$'
EOF
}

use_ocr=false
dry_run=false

# Wrapper-only flags go before the inputs; shared CLI options go after the file list.
while [[ $# -gt 0 ]]; do
  case "$1" in
    --ocr)
      use_ocr=true
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 2
fi

inputs=()
# Validate every input before starting work, so a typo in the second path costs nothing.
while [[ $# -gt 0 && "$1" != -* ]]; do
  source_path="$1"
  shift
  # Dropped-in sources take priority; Downloads remains the fallback for existing commands.
  # A slash always makes the caller's location explicit, even outside this repository.
  if [[ "$source_path" != */* ]]; then
    if [[ -f "$repo_dir/input/$source_path" ]]; then
      source_path="$repo_dir/input/$source_path"
    else
      source_path="$HOME/Downloads/$source_path"
    fi
  fi
  if [[ ! -f "$source_path" ]]; then
    echo "Input not found: $source_path" >&2
    exit 2
  fi
  # Resolve paths before changing directories and keep spaces intact in the array.
  source_dir="$(cd -- "$(dirname -- "$source_path")" && pwd -P)"
  inputs+=("$source_dir/$(basename -- "$source_path")")
done

if [[ ${#inputs[@]} -eq 0 ]]; then
  usage >&2
  exit 2
fi

if [[ ! -f "$config_file" ]]; then
  echo "Missing local config: $config_file" >&2
  echo "Run: cp .case2audio.env.example .case2audio.env" >&2
  exit 2
fi

# This ignored file holds local AWS values without baking them into Git history.
set -a
# shellcheck disable=SC1090
source "$config_file"
set +a

bucket="${CASE2AUDIO_BUCKET:-}"
region="${CASE2AUDIO_REGION:-us-east-1}"
profile="${CASE2AUDIO_PROFILE:-case2audio}"

if [[ -z "$bucket" || "$bucket" == "YOUR-UNIQUE-CASE2AUDIO-BUCKET" ]]; then
  echo "Set CASE2AUDIO_BUCKET in $config_file" >&2
  exit 2
fi

# Previewing paths must not trigger Python downloads or install any packages.
if [[ "$dry_run" == false ]] && ! case2audio_runtime_ready "$repo_dir"; then
  echo "Preparing case2audio for this folder (first run only)..."
  bash "$repo_dir/scripts/bootstrap.sh"
fi

command=(
  # Launch through Python: console-script shebangs contain paths that break after a move.
  "$python_bin" -m case2audio.cli make "${inputs[@]}"
  --bucket "$bucket"
  --region "$region"
  --profile "$profile"
)

# Born-digital PDFs are the common case and do not need slow OCR.
if [[ "$use_ocr" == false ]]; then
  command+=(--no-ocr)
fi

# Advanced CLI flags remain available without making the wrapper complicated.
command+=("$@")

if [[ "$dry_run" == true ]]; then
  printf 'Would run:'
  printf ' %q' "${command[@]}"
  printf '\n'
  exit 0
fi

# Keep every generated job under this repository's ignored generated/ folder.
cd "$repo_dir"
# Prefer the checked-out source so normal use immediately includes local fixes.
exec env PYTHONPATH="$repo_dir/src${PYTHONPATH:+:$PYTHONPATH}" "${command[@]}"
